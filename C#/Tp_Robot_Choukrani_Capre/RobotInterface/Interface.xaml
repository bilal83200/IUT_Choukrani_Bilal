<Window x:Class="RobotInterface.Interface"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:oscillo="clr-namespace:WpfOscilloscopeControl;assembly=WpfOscilloscopeControl"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RobotInterface"
        mc:Ignorable="d"
        Title="Interface" Height="600" Width="1000"
        Background="red">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Emission Section -->
        <GroupBox x:Name="Emission" Header="Émission" Grid.Column="0" Grid.Row="1" Margin="5"
                  Background="#FF2C2C2C" BorderBrush="#FF3F51B5" Foreground="White">
            <TextBox x:Name="textboxEmission" 
                     TextWrapping="Wrap" 
                     Background="#FF2C2C2C" 
                     Foreground="White"
                     BorderBrush="#FF3F51B5" 
                     AcceptsReturn="True"
                     Padding="5"
                     VerticalScrollBarVisibility="Auto"
                     KeyUp="textboxEmission_KeyUp" />
        </GroupBox>

        <!-- Réception Section -->
        <GroupBox x:Name="Reception" Header="Réception" Grid.Column="2" Grid.Row="1" Margin="5"
                  Background="#FF333333" BorderBrush="#FF3F51B5" Foreground="White">
            <TextBox x:Name="textboxReception" 
                     TextWrapping="Wrap" 
                     Background="#FF333333" 
                     Foreground="White"
                     BorderBrush="#FF3F51B5" 
                     SelectionBrush="#FF7986CB" 
                     AcceptsReturn="True" 
                     IsReadOnly="True"
                     Padding="5"
                     VerticalScrollBarVisibility="Auto" />
        </GroupBox>

        <!-- Oscilloscope -->
        <oscillo:WpfOscilloscope x:Name="oscilloSpeed" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="1" Margin="5" />

        <!-- Buttons -->
        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" >
            <Button x:Name="buttonEnvoyer" Content="Envoyer" Width="120" Height="35" Click="buttonEnvoyer_Click" Background="#FF3F51B5" Foreground="White"/>
            <Button x:Name="buttonTest" Content="Test" Width="120" Height="35" Click="buttonTest_Click" Background="#FF3F51B5" Foreground="White"/>
            <Button x:Name="buttonSupprimer" Content="Supprimer" Width="120" Height="35" Click="buttonSupprimer_Click" Background="#FF3F51B5" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>




